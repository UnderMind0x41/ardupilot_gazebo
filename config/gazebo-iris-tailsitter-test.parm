# Isolated QACRO input/swap control fixture based on the stock Gazebo Iris.
#
# This is deliberately not a forward-flight aircraft: the unchanged Iris
# motor/drag physics are rotated into an ArduPlane tailsitter aircraft frame so
# the QACRO body-axis response can be measured without Swan-specific effects.

Q_ENABLE             1
Q_FRAME_CLASS        1
Q_FRAME_TYPE         1
Q_TAILSIT_ENABLE     2
Q_TAILSIT_MOTMX      15
Q_ACRO_RY_SWAP       0

SERVO5_FUNCTION      33
SERVO6_FUNCTION      34
SERVO7_FUNCTION      35
SERVO8_FUNCTION      36
SERVO5_MIN           1000
SERVO6_MIN           1000
SERVO7_MIN           1000
SERVO8_MIN           1000
SERVO5_MAX           2000
SERVO6_MAX           2000
SERVO7_MAX           2000
SERVO8_MAX           2000
Q_M_PWM_MIN          1000
Q_M_PWM_MAX          2000

# Stock Iris motor model and ArduPilot Copter defaults.
Q_M_THST_EXPO        0.65
Q_M_THST_HOVER       0.39
Q_M_SPIN_ARM         0.05
Q_M_SPIN_MIN         0.10
Q_M_SPIN_MAX         0.95

# Keep the ordinary Iris / QuadPlane control bandwidth.  The much higher
# large-wing Swan tailsitter gains are intentionally unsuitable for this
# low-inertia stock quad control fixture.
Q_A_ANG_RLL_P        6.0
Q_A_ANG_PIT_P        6.0
Q_A_ANG_YAW_P        4.5
Q_A_RAT_RLL_P        0.108
Q_A_RAT_RLL_I        0.108
Q_A_RAT_RLL_D        0.001
Q_A_RAT_PIT_P        0.103
Q_A_RAT_PIT_I        0.103
Q_A_RAT_PIT_D        0.001
Q_A_RAT_YAW_P        0.200
Q_A_RAT_YAW_I        0.020
Q_A_RAT_YAW_D        0.000

ARSPD_TYPE           0
ARSPD_USE            0
Q_ASSIST_SPEED       0

INS_ACCOFFS_X        0.001
INS_ACCOFFS_Y        0.001
INS_ACCOFFS_Z        0.001
INS_ACCSCAL_X        1.001
INS_ACCSCAL_Y        1.001
INS_ACCSCAL_Z        1.001
INS_GYR_CAL          0
INS_USE2             0
INS_USE3             0
SIM_IMU_COUNT        1
EK3_IMU_MASK         1
INS_ACC2OFFS_X        0
INS_ACC2OFFS_Y        0
INS_ACC2OFFS_Z        0
INS_ACC2SCAL_X        1
INS_ACC2SCAL_Y        1
INS_ACC2SCAL_Z        1
BATT_MONITOR         4
ARMING_RUDDER        2
SCHED_LOOP_RATE      300

FLTMODE1             17
FLTMODE2             17
FLTMODE3             17
FLTMODE4             17
FLTMODE5             17
FLTMODE6             17
FLTMODE_CH           5
